# Copy this file to .env.local and export the variables in your shell.
# Never commit a file containing real credentials.

STREAMEVAL_JUDGER_BACKEND=openai_compatible
STREAMEVAL_JUDGER_API_BASE=https://your-judge.example.com/v1
STREAMEVAL_JUDGER_API_KEY=replace_me
STREAMEVAL_JUDGER_MODEL=your-judge-model

# Optional local server settings.
NUM_GPUS=1
BASE_PORT=8000
TORCH_DTYPE=bf16
ATTN_IMPL=sdpa
